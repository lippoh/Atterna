generator client {
  provider = "prisma-client-js"
}

enum Locale {
  EL
  EN
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  emailVerified DateTime?
  passwordHash  String?
  locale        Locale       @default(EL)
  isAdmin       Boolean      @default(false)
  passwordChangedAt DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  memberships   Membership[]
  auditLogs     AuditLog[]   @relation("actor")
}

model Organization {
  id               String       @id @default(cuid())
  name             String
  stripeCustomerId String?      @unique
  subscription     Subscription?
  memberships      Membership[]
  businesses       Business[]
  auditLogs        AuditLog[]
  reportLogs       ReportLog[]
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           String       @default("OWNER")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Business {
  id                 String           @id @default(cuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id])
  name               String
  category           String
  city               String
  region             String?
  countryCode        String           @default("GR")
  phone              String?
  website            String?
  reviewUrl          String? // Google write-review deep link (from GBP placeId)
  locale             Locale           @default(EL)
  timezone           String           @default("Europe/Athens")
  currency           String           @default("EUR")
  gbpConnection      GbpConnection?
  reviews            Review[]
  feedbackRequests   FeedbackRequest[]
  feedbackSubmissions FeedbackSubmission[]
  reportLogs         ReportLog[]
  aiSettings         Json? // tone, formality, signature, forbidden phrases
  deletedAt          DateTime?
  createdAt          DateTime         @default(now())
  @@index([organizationId])
}

model GbpConnection {
  id              String   @id @default(cuid())
  businessId      String   @unique
  business        Business @relation(fields: [businessId], references: [id])
  accountName     String
  locationName    String
  locationId      String
  accessTokenEnc  String
  refreshTokenEnc String
  tokenExpiresAt  DateTime
  scope           String
  status          String   @default("ACTIVE")
  lastSyncAt      DateTime?
  lastSyncError   String?
}

model Review {
  id                String          @id @default(cuid())
  organizationId    String
  businessId        String
  business          Business        @relation(fields: [businessId], references: [id])
  source            String
  externalId        String?
  rating            Int
  text              String?
  language          String?
  reviewerName      String?
  createdOnPlatform DateTime?
  receivedAt        DateTime        @default(now())
  createdAt         DateTime        @default(now())
  repliedAt         DateTime?
  deletedAt         DateTime?
  analysis          ReviewAnalysis?
  drafts            ResponseDraft[]

  @@unique([businessId, source, externalId])
  @@index([businessId, receivedAt])
  @@index([organizationId, receivedAt])
}

model ReviewAnalysis {
  id            String   @id @default(cuid())
  reviewId      String   @unique
  review        Review   @relation(fields: [reviewId], references: [id])
  sentiment     Sentiment
  urgency       String   @default("LOW")
  language      String
  topics        String[] @default([])
  complaints    Json
  compliments   Json
  actionable    Boolean  @default(false)
  promptVersion String
  model         String
  tokensIn      Int      @default(0)
  tokensOut     Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([reviewId, createdAt])
}

model AuditLog {
  id             String        @id @default(cuid())
  actorId        String?
  actorUserId    String?
  entity         String?
  entityId       String?
  ip             String?
  organizationId String?
  action         String
  details        Json?
  createdAt      DateTime      @default(now())
  actor          User?         @relation("actor", fields: [actorId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])
}

model Subscription {
  id                   String       @id @default(cuid())
  organizationId       String       @unique
  organization         Organization @relation(fields: [organizationId], references: [id])
  status               String       @default("TRIALING")
  plan                 String @default("STARTER")
  planKey              String       @default("STARTER")
  currentPeriodEnd     DateTime?
  stripeSubscriptionId String? @unique
  canceledAt           DateTime?
  cancelAtPeriodEnd    Boolean @default(false)
  accessEndsAt         DateTime?
}

model FeedbackRequest {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id])
  token         String   @unique
  label         String?
  active        Boolean  @default(true)
  customerEmail String   @default("")
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  submissions   FeedbackSubmission[]
}

model FeedbackSubmission {
  id                String            @id @default(cuid())
  businessId        String
  business          Business          @relation(fields: [businessId], references: [id])
  requestId         String?
  feedbackRequestId String
  feedbackRequest   FeedbackRequest   @relation(fields: [feedbackRequestId], references: [id])
  organizationId    String
  rating            Int
  comment           String?
  ipHash            String?
  createdAt         DateTime          @default(now())
}

model ResponseDraft {
  id        String      @id @default(cuid())
  reviewId  String
  review    Review      @relation(fields: [reviewId], references: [id])
  content   String @default("")
  text      String?
  editedText String?
  language String?
  model     String?
  promptVersion String?
  externalReplyId String?
  approvedAt DateTime?
  approvedBy String?
  status    String      @default("DRAFT")
  publishedAt DateTime?
  failureReason String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model AiUsageLog {
  id             String   @id @default(cuid())
  organizationId String
  task           String
  model          String
  tokensIn       Int
  tokensOut      Int
  costMicros     Int
  createdAt      DateTime @default(now())
}

model Job {
  id         String   @id @default(cuid())
  type       String
  payload    Json
  dedupeKey  String?  @unique
  state      String   @default("QUEUED")
  attempts   Int      @default(0)
  runAt      DateTime @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  lastError  String?
  createdAt  DateTime @default(now())
}

model ReportLog {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  businessId     String?
  business       Business?     @relation(fields: [businessId], references: [id])
  kind           String
  periodStart    DateTime      @default(now())
  metrics        Json?
  createdAt      DateTime      @default(now())
}

model WebhookEvent {
  id        String   @id
  type      String
  payload   Json?
  createdAt DateTime @default(now())
}

model Invoice {
  id             String   @id @default(cuid())
  organizationId String
  stripeInvoiceId String  @unique
  amount         Int @default(0)
  totalCents     Int?
  currency       String?
  vatCents       Int?
  hostedUrl      String?
  status         String @default("PAID")
  createdAt      DateTime @default(now())
}

model ImpersonationSession {
  id          String   @id @default(cuid())
  adminId     String
  targetUserId String
  token       String   @unique @default(cuid())
  expiresAt   DateTime
  endedAt     DateTime?
  reason      String?
  createdAt   DateTime @default(now())
}