generator client {
  provider = "prisma-client-js"
}

enum Locale {
  EL
  EN
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  emailVerified DateTime?
  passwordHash  String?
  locale        Locale       @default(EL)
  isAdmin       Boolean      @default(false)
  passwordChangedAt DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  memberships   Membership[]
  auditLogs     AuditLog[]   @relation("actor")
}

model Organization {
  id               String       @id @default(cuid())
  name             String
  stripeCustomerId String?      @unique
  subscription     Subscription?
  memberships      Membership[]
  businesses       Business[]
  invoices         Invoice[]
  auditLogs        AuditLog[]
  reportLogs       ReportLog[]
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           String       @default("OWNER")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Business {
  id                 String           @id @default(cuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id])
  name               String
  category           String
  city               String
  region             String?
  countryCode        String           @default("GR")
  phone              String?
  website            String?
  reviewUrl          String? // Google write-review deep link (from GBP placeId)
  locale             Locale           @default(EL)
  timezone           String           @default("Europe/Athens")
  currency           String           @default("EUR")
  gbpConnection      GbpConnection?
  reviews            Review[]
  feedbackRequests   FeedbackRequest[]
  feedbackSubmissions FeedbackSubmission[]
  reportLogs         ReportLog[]
  reputationSnapshots ReputationSnapshot[]
  issues             Issue[]
  recommendations    Recommendation[]
  competitors        Competitor[]
  businessInsights   BusinessInsight[]
  aiSettings         Json? // tone, formality, signature, forbidden phrases
  deletedAt          DateTime?
  createdAt          DateTime         @default(now())
  @@index([organizationId])
}

model GbpConnection {
  id              String   @id @default(cuid())
  businessId      String   @unique
  business        Business @relation(fields: [businessId], references: [id])
  accountName     String
  locationName    String
  locationId      String
  accessTokenEnc  String
  refreshTokenEnc String
  tokenExpiresAt  DateTime
  scope           String
  status          String   @default("ACTIVE")
  lastSyncAt      DateTime?
  lastSyncError   String?
}

model Review {
  id                String          @id @default(cuid())
  organizationId    String
  businessId        String
  business          Business        @relation(fields: [businessId], references: [id])
  source            String
  externalId        String?
  rating            Int
  text              String?
  language          String?
  reviewerName      String?
  sourceUrl         String? // deep link to the review on its platform (imports)
  createdOnPlatform DateTime?
  receivedAt        DateTime        @default(now())
  createdAt         DateTime        @default(now())
  repliedAt         DateTime?
  deletedAt         DateTime?
  analysis          ReviewAnalysis?
  drafts            ResponseDraft[]

  @@unique([businessId, source, externalId])
  @@index([businessId, receivedAt])
  @@index([organizationId, receivedAt])
}

model ReviewAnalysis {
  id            String   @id @default(cuid())
  reviewId      String   @unique
  review        Review   @relation(fields: [reviewId], references: [id])
  sentiment     Sentiment
  urgency       String   @default("LOW")
  language      String
  topics        String[] @default([])
  complaints    Json
  compliments   Json
  actionable    Boolean  @default(false)
  promptVersion String
  model         String
  tokensIn      Int      @default(0)
  tokensOut     Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([reviewId, createdAt])
}

model AuditLog {
  id             String        @id @default(cuid())
  actorId        String?
  actorUserId    String?
  entity         String?
  entityId       String?
  ip             String?
  organizationId String?
  action         String
  details        Json?
  createdAt      DateTime      @default(now())
  actor          User?         @relation("actor", fields: [actorId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])
}

model Subscription {
  id                   String       @id @default(cuid())
  organizationId       String       @unique
  organization         Organization @relation(fields: [organizationId], references: [id])
  status               String       @default("TRIALING")
  plan                 String       @default("STARTER") // DEPRECATED: legacy column superseded by planKey; unwritten since V2. Retained deliberately — retiring it is a separate additive migration (see docs/ARCHITECTURE-BILLING.md).
  planKey              String       @default("STARTER")
  currentPeriodEnd     DateTime?
  stripeSubscriptionId String? @unique
  canceledAt           DateTime?
  cancelAtPeriodEnd    Boolean @default(false)
  accessEndsAt         DateTime?
}

model FeedbackRequest {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id])
  token         String   @unique
  label         String?
  active        Boolean  @default(true)
  customerEmail String   @default("")
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  submissions   FeedbackSubmission[]
}

model FeedbackSubmission {
  id                String            @id @default(cuid())
  businessId        String
  business          Business          @relation(fields: [businessId], references: [id])
  requestId         String?
  feedbackRequestId String
  feedbackRequest   FeedbackRequest   @relation(fields: [feedbackRequestId], references: [id])
  organizationId    String
  rating            Int
  comment           String?
  ipHash            String?
  createdAt         DateTime          @default(now())
}

model ResponseDraft {
  id        String      @id @default(cuid())
  reviewId  String
  review    Review      @relation(fields: [reviewId], references: [id])
  content   String @default("")
  text      String?
  editedText String?
  language String?
  model     String?
  promptVersion String?
  externalReplyId String?
  approvedAt DateTime?
  approvedBy String?
  status    String      @default("DRAFT")
  publishedAt DateTime?
  failureReason String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model AiUsageLog {
  id             String   @id @default(cuid())
  organizationId String
  task           String
  model          String
  tokensIn       Int
  tokensOut      Int
  costMicros     Int
  createdAt      DateTime @default(now())
}

model Job {
  id         String   @id @default(cuid())
  type       String
  payload    Json
  dedupeKey  String?  @unique
  state      String   @default("QUEUED")
  attempts   Int      @default(0)
  runAt      DateTime @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  lastError  String?
  createdAt  DateTime @default(now())
}

model ReportLog {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  businessId     String?
  business       Business?     @relation(fields: [businessId], references: [id])
  kind           String
  periodStart    DateTime      @default(now())
  metrics        Json?
  createdAt      DateTime      @default(now())
}

model WebhookEvent {
  id        String   @id
  type      String
  payload   Json?
  createdAt DateTime @default(now())
}

model Invoice {
  id              String       @id @default(cuid())
  organizationId  String
  // Financial records reference a real organization (RESTRICT: an org
  // with invoices is never silently cascade-deleted). Written only by
  // the Stripe webhook; unresolvable attribution fails loudly instead
  // of storing a placeholder — see docs/ARCHITECTURE-BILLING.md.
  organization    Organization  @relation(fields: [organizationId], references: [id])
  stripeInvoiceId String  @unique
  amount          Int @default(0) // DEPRECATED: legacy column superseded by totalCents; unwritten since V2. Retained deliberately — retiring it is a separate additive migration (see docs/ARCHITECTURE-BILLING.md).
  totalCents      Int?
  currency        String?
  vatCents        Int?
  hostedUrl       String?
  status          String @default("PAID")
  createdAt       DateTime @default(now())

  @@index([organizationId])
}

model ImpersonationSession {
  id          String   @id @default(cuid())
  adminId     String
  targetUserId String
  token       String   @unique @default(cuid())
  expiresAt   DateTime
  endedAt     DateTime?
  reason      String?
  createdAt   DateTime @default(now())
}

// ── Reputation Intelligence (multi-source refactor) ─────────────────────
// All additive: the unified Review/Feedback models above stay untouched;
// these tables make historical intelligence, issues, recommendations,
// competitors and cached AI summaries first-class data.

// Daily deterministic Health Score history (computed by app code — never
// the LLM). One row per business per day; `breakdown` keeps every input
// and sub-score so any past score is explainable and auditable.
model ReputationSnapshot {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  date        DateTime // day granularity, stored at 00:00 UTC
  score       Int // 0-100
  breakdown   Json
  createdAt   DateTime @default(now())

  @@unique([businessId, date])
  @@index([businessId, date])
}

// First-class recurring / emerging customer problems, detected
// deterministically from persisted ReviewAnalysis categories.
model Issue {
  id               String    @id @default(cuid())
  organizationId   String
  businessId       String
  business         Business  @relation(fields: [businessId], references: [id])
  category         String // closed-vocabulary theme key (ai/schemas.ts)
  kind             String // RECURRING | EMERGING
  severity         String    @default("MEDIUM") // LOW | MEDIUM | HIGH
  mentionsCurrent  Int       @default(0) // last 90d (recurring) / last 30d (emerging)
  mentionsPrevious Int       @default(0) // comparison window
  trend            String    @default("STABLE") // UP | DOWN | STABLE
  status           String    @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED | DISMISSED
  sources          String[]  @default([])
  firstDetectedAt  DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  recommendations  Recommendation[]

  @@unique([businessId, category, kind])
  @@index([businessId, status])
}

// Recommended actions — the feedback loop: problem → recommendation →
// business action → future feedback → measured improvement.
model Recommendation {
  id              String    @id @default(cuid())
  organizationId  String
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id])
  issueId         String?
  issue           Issue?    @relation(fields: [issueId], references: [id])
  title           String
  impact          String    @default("MEDIUM") // HIGH | MEDIUM | LOW
  steps           String[]  @default([])
  status          String    @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED | DISMISSED
  source          String    @default("RULES") // RULES | AI
  evidence        Json?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([businessId, status])
}

// Competitors the owner confirmed (manual entry; suggestions are only
// labeled as such until confirmed). No scraping, no fabricated stats —
// nullable rating/count means "not provided".
model Competitor {
  id              String    @id @default(cuid())
  organizationId  String
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id])
  name            String
  category        String?
  city            String?
  rating          Float?
  reviewCount     Int?
  status          String    @default("CONFIRMED") // SUGGESTED | CONFIRMED | DISMISSED
  suggestedReason String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([businessId, name])
  @@index([businessId, status])
}

// Cached business-level AI insights, keyed by a data fingerprint — the
// 90-day summary is regenerated ONLY when the underlying data changed
// (cost control, spec §16). Kind: QUARTERLY_SUMMARY | HEALTH_EXPLAIN.
model BusinessInsight {
  id             String   @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id])
  kind           String
  windowStart    DateTime
  windowEnd      DateTime
  fingerprint    String
  payload        Json
  model          String?
  promptVersion  String?
  tokensIn       Int      @default(0)
  tokensOut      Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([businessId, kind, createdAt])
}