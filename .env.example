# Atterna environment template — copy to .env and fill in.
# The Prisma CLI reads it via prisma7.config.ts ("dotenv/config"); the
# Next.js runtime and the Vitest setup (tests/setup.ts) read it too.

# ── Database ──────────────────────────────────────────────────────────────
# The application database. NEVER let the test suite run against it:
# tests/unit/tenant-isolation.test.ts truncates every table on every run.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB"

# Disposable database used by `pnpm test` (the tenant-isolation suite).
# Point it at a local Postgres or a Neon branch. If unset, the tests fall
# back to DATABASE_URL ONLY when it points at localhost — a remote
# DATABASE_URL is refused on purpose.
#   local:     postgresql://postgres@localhost:5432/atterna_test
#   neon:      postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/branchdb?sslmode=require
TEST_DATABASE_URL="postgresql://postgres@localhost:5432/atterna_test"

# ── App / Auth ────────────────────────────────────────────────────────────
# Public origin of the deployment (no trailing slash). Used for Stripe
# Checkout success/cancel URLs, the Billing Portal return URL and the
# GBP OAuth callback. REQUIRED before Stripe Checkout works.
APP_URL="https://app.your-domain.gr"

# Auth.js (NextAuth v5). AUTH_SECRET: generate with
#   pnpm exec auth secret   (or: openssl rand -base64 32)
# REQUIRED — 32+ characters.
AUTH_SECRET="REPLACE_WITH_RANDOM_32PLUS_CHARS"
AUTH_URL="https://app.your-domain.gr"

# ── Stripe (billing) ──────────────────────────────────────────────────────
# SECRETS — never commit real values; never mix test and live modes:
# test-mode keys look like sk_test_… / whsec_… on the Dashboard's
# "test mode" view; live keys only exist in the "live mode" view.
# During development and smoke testing use TEST-MODE values ONLY.

# API secret key (test: sk_test_…, live: sk_live_…). REQUIRED for checkout,
# the Billing Portal and the webhook's subscription retrieval.
STRIPE_SECRET_KEY="sk_test_REPLACE_ME"

# Publishable key (test: pk_test_…, live: pk_live_…). Public by design —
# safe to expose to the browser. Optional: the current checkout flow is a
# full redirect to Stripe's hosted page and does not require it.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_REPLACE_ME"

# Webhook signing secret for POST /api/webhooks/stripe (test: from the
# test-mode webhook endpoint; live: from the live-mode endpoint). REQUIRED
# — the route rejects every delivery whose signature cannot be verified
# against this value.
STRIPE_WEBHOOK_SECRET="whsec_REPLACE_ME"

# Recurring monthly EUR Prices for the three plans (created in the Stripe
# Dashboard, see README-INSTALL.md). REQUIRED — map them exactly; a price
# that matches none of these makes the webhook fail loudly instead of
# guessing a plan.
STRIPE_PRICE_STARTER="price_REPLACE_ME"
STRIPE_PRICE_GROWTH="price_REPLACE_ME"
STRIPE_PRICE_PRO="price_REPLACE_ME"

# ── Resend (transactional email) ──────────────────────────────────────────
# Server-side mailer for signup verification, password reset, owner
# alerts and the weekly report (src/lib/mailer.ts is the only boundary).
# REQUIRED before any email can be sent. API key from Resend → API Keys
# (looks like re_…). Server-only: the key never reaches the browser
# bundle — never expose it, never commit real values.
RESEND_API_KEY="re_REPLACE_ME"

# The single sender for every Atterna email — one configuration source,
# no hardcoded From in code. Format: "Display Name <local@domain>" or a
# bare address. The domain MUST be added and verified in Resend
# (Domains → Add → publish the DNS records: SPF, DKIM and the domain
# verification TXT). Canonical transactional sender:
#   Atterna <no-reply@YOUR_DOMAIN>
# NEVER use onboarding@resend.dev outside local development — it can
# only deliver to your own Resend account email and will bounce in
# production.
EMAIL_FROM="Atterna <no-reply@your-domain.gr>"
